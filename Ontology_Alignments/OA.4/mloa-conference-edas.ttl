@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://conference#Call_for_paper> owl:equivalentClass <http://edas#CallForPapers> .

<http://conference#Committee_member> rdfs:subClassOf <http://edas#TPCMember> .

<http://conference#Conference> owl:equivalentClass <http://edas#Conference> .

<http://conference#Conference_applicant> owl:equivalentClass <http://edas#Conference> .

<http://conference#Conference_contributor> rdfs:subClassOf <http://edas#ConferenceChair> .

<http://conference#Conference_document> owl:equivalentClass <http://edas#Conference> .

<http://conference#Conference_fees> owl:equivalentClass <http://edas#Conference> .

<http://conference#Conference_part> owl:equivalentClass <http://edas#Conference> .

<http://conference#Conference_participant> rdfs:subClassOf <http://edas#ConferenceChair> .

<http://conference#Conference_volume> owl:equivalentClass <http://edas#Conference> .

<http://conference#Conference_www> owl:equivalentClass <http://edas#Conference> .

<http://conference#Organization> owl:equivalentClass <http://edas#Organization> .

<http://conference#Paper> owl:equivalentClass <http://edas#Paper> .

<http://conference#Person> owl:equivalentClass <http://edas#Person> .

<http://conference#Presentation> owl:equivalentClass <http://edas#PaperPresentation> .

<http://conference#Review> owl:equivalentClass <http://edas#Review> .

<http://conference#Reviewer> owl:equivalentClass <http://edas#Reviewer> .

<http://conference#Topic> owl:equivalentClass <http://edas#Topic> .

<http://conference#Workshop> owl:equivalentClass <http://edas#Workshop> .

<http://conference#has_a_location> owl:equivalentProperty <http://edas#hasLocation> .

<http://conference#has_a_name> owl:equivalentProperty <http://edas#hasName> .

<http://conference#has_an_email> owl:equivalentProperty <http://edas#hasEmail> .

<http://conference#has_members> owl:equivalentProperty <http://edas#hasMember> .

<http://conference#has_the_first_name> owl:equivalentProperty <http://edas#hasFirstName> .

<http://conference#has_the_last_name> owl:equivalentProperty <http://edas#hasLastName> .

